{
  "name": "devhub-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "orval --config orval.config.ts",
    "api:refresh": "curl -fsS http://127.0.0.1:8080/openapi/json -o openapi/backend.json && pnpm api:generate"
  },
  "dependencies": {
    "@sentry/vue": "^11.11.0",
    "@tanstack/vue-query": "^5.106.1",
    "@tanstack/vue-table": "^9.3.1",
    "@tanstack/vue-virtual": "^3.13.52",
    "@unhead/vue": "^3.4.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^15.0.0",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinia-shared-state": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^4.15.1",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.4",
    "orval": "^8.47.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
